# Required: SensorSphere base URL as visible from this agent.
SENSORSPHERE_URL=http://100.64.0.8:8080

# Required: raw token shown by SensorSphere only at creation/regeneration.
SENSORSPHERE_AGENT_TOKEN=ssma_replace_me

# Heartbeat cadence in seconds.
SENSORSPHERE_HEARTBEAT_INTERVAL_SECONDS=30

# Assigned-check configuration polling cadence in seconds.
SENSORSPHERE_CONFIG_POLL_INTERVAL_SECONDS=15

# HTTP request timeout toward SensorSphere in milliseconds.
SENSORSPHERE_REQUEST_TIMEOUT_MS=10000

# Persistent state file containing last valid config + queued results.
SENSORSPHERE_STATE_FILE=/app/data/monitor-agent-state.json

# Maximum queued results retained while SensorSphere is unreachable.
SENSORSPHERE_QUEUE_MAX_RESULTS=10000

# Maximum age of queued results before pruning, in hours.
SENSORSPHERE_QUEUE_RETENTION_HOURS=72

# Logging verbosity: debug, info, warn, error.
SENSORSPHERE_LOG_LEVEL=info

# Optional JSON object sent with heartbeat, e.g. {"site":"home","network":"lan"}
SENSORSPHERE_AGENT_LABELS={}

# Docker Compose host-side data directory (used for ${DATA_DIR} substitution).
DATA_DIR=./data
